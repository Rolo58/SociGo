# Soci Go environment configuration
#
# Soci Go runs on Convex. The backend functions live in `convex/` and the
# browser talks to the deployment through `VITE_CONVEX_URL`.
#
# Copy this file to `.env.local` and fill in the values for your deployment.
# `.env.local` is git-ignored; never commit real credentials.

# Browser-facing deployment URL. For Convex Cloud this looks like
# https://your-project-name.convex.cloud . For a self-hosted backend use the
# public origin you expose (see "Self-hosting the backend" in the README).
VITE_CONVEX_URL=

# Origin used for Convex HTTP actions. Usually the same as VITE_CONVEX_URL.
VITE_CONVEX_SITE_URL=

# --- Server-side only, used by the `convex` CLI to push functions ---
# Only needed when deploying to a self-hosted backend. Leave blank for Convex Cloud.

# Local origin of the self-hosted backend, e.g. http://127.0.0.1:3210
CONVEX_SELF_HOSTED_URL=

# Admin key for the self-hosted instance: "<instance-name>|<instance-secret>".
# Generate it with:
#   convex-local-backend keygen admin-key --instance-name <name> --instance-secret <secret>
# This key can deploy code. It must never be exposed to the browser.
CONVEX_SELF_HOSTED_ADMIN_KEY=
