# ApprovalFlow environment configuration
#
# Phase 1 (current): the frontend runs entirely on local sample data and needs
# no environment variables. Copying this file is optional.
#
# Phase 2 (Supabase): fill these in before connecting the backend.
# Only the anon/public key belongs in frontend builds. Never ship the
# service-role key to the browser.

# Public Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Public anon key (safe for the browser when RLS is enabled)
VITE_SUPABASE_ANON_KEY=

# Optional: base URL used when generating client review links.
# Leave blank to use the current origin.
VITE_APP_URL=

# Optional: storage provider for uploaded creatives.
# "local" keeps files in the browser; Phase 2 adds "supabase".
VITE_STORAGE_DRIVER=local
